#!/usr/bin/env bash
# tkwater — short alias for tallkitchen_water (the rule generator)
# Runs Water with all arguments passed through.
# Auto-activates the venv if it exists.
set -e
LAB_DIR="${TALLKITCHEN_LAB_DIR:-$HOME/detection-lab}"
cd "$LAB_DIR"
if [ -f "venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    source venv/bin/activate
fi
exec python generate_rule.py "$@"
